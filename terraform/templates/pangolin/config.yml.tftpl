# Verwaltet von pangolin-hetzner-setup. Optionen: https://docs.pangolin.net/
# __SERVER_SECRET__ wird beim ersten Start auf dem Server durch ein zufälliges
# Secret ersetzt (pangolin-bootstrap), damit es nie in cloud-init/tfstate landet.

gerbil:
    start_port: 51820
    base_endpoint: "${dashboard_domain}"

app:
    dashboard_url: "https://${dashboard_domain}"
    log_level: "info"
    telemetry:
        anonymous_usage: false

domains:
    domain1:
        base_domain: "${base_domain}"

server:
    secret: "__SERVER_SECRET__"
    cors:
        origins: ["https://${dashboard_domain}"]
        methods: ["GET", "POST", "PUT", "DELETE", "PATCH"]
        allowed_headers: ["X-CSRF-Token", "Content-Type"]
        credentials: false

flags:
    require_email_verification: false
    disable_signup_without_invite: true
    disable_user_create_org: false
    allow_raw_resources: true
