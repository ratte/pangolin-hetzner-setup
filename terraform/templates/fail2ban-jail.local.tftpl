# Verwaltet von pangolin-hetzner-setup.
# Bans laufen über eine eigene nftables-Tabelle (unabhängig von ufw, IPv4 + IPv6).

[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5
backend  = systemd
banaction = nftables-multiport
banaction_allports = nftables-allports
ignoreip = 127.0.0.1/8 ::1

[sshd]
enabled  = true
port     = ${ssh_port}
mode     = aggressive
maxretry = 4

# Wiederholungstäter: 5 Bans innerhalb eines Tages -> 1 Woche auf allen Ports.
[recidive]
enabled  = true
backend  = auto
logpath  = /var/log/fail2ban.log
banaction = %(banaction_allports)s
bantime  = 1w
findtime = 1d
maxretry = 5
