# Managed by pangolin-hetzner-setup.
# Bans use a separate nftables table (independent of ufw, IPv4 + IPv6).

[DEFAULT]
bantime  = 1h
findtime = 10m
maxretry = 5
backend  = systemd
banaction = nftables-multiport
banaction_allports = nftables-allports
ignoreip = 127.0.0.1/8 ::1

[sshd]
enabled  = true
port     = ${ssh_port}
mode     = aggressive
maxretry = 4

# Repeat offenders: 5 bans within one day -> 1 week on all ports.
[recidive]
enabled  = true
backend  = auto
logpath  = /var/log/fail2ban.log
banaction = %(banaction_allports)s
bantime  = 1w
findtime = 1d
maxretry = 5
