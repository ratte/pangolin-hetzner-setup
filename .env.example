# Copy to .env and fill in:  cp .env.example .env && chmod 600 .env
# .env is never committed (.gitignore).

# --- Required ------------------------------------------------------------------
# Hetzner Console → Project → Security → API tokens (Read & Write).
# Leave empty: ./setup.sh asks for it (hidden input) and offers to save it here.
HCLOUD_TOKEN=
# FQDN of the Pangolin dashboard (the A record must point to the server)
DASHBOARD_DOMAIN=pangolin.example.com
# Base domain for resources (e.g. app.example.com)
BASE_DOMAIN=example.com
# Contact address for Let's Encrypt
LETSENCRYPT_EMAIL=admin@example.com

# --- Server --------------------------------------------------------------------
SERVER_NAME=pangolin
SERVER_TYPE=cx23
LOCATION=nbg1
IMAGE=ubuntu-26.04
TIMEZONE=Europe/Zurich
# Reboot after security updates (HH:MM) or "off"
AUTO_REBOOT_TIME=04:00
# true = Hetzner delete/rebuild protection
PROTECTION=false

# --- Access --------------------------------------------------------------------
# SSH key source. ./setup.sh asks for it before creating the server and
# saves the answer here. One of the two (or both) is enough:
#   GITHUB_USER     -> keys from https://github.com/<GITHUB_USER>.keys
#   SSH_PUBLIC_KEY  -> your own public key, in quotes
GITHUB_USER=
SSH_PUBLIC_KEY=
# Login user on the server (root is locked). ./setup.sh asks before creating
# the server and suggests this value.
ADMIN_USER=peng
# SSH port on the server (port 22 is closed)
SSH_PORT=2222
# SSH source networks at creation: "any" = open everywhere. Restrict later with
#   ./setup.sh admin-access "203.0.113.10/32"
ADMIN_ALLOWED_CIDRS=any
# Optional: private key if it is not in the ssh-agent or the default path.
# Must match SSH_PUBLIC_KEY / the GitHub keys, otherwise fail2ban bans your IP.
#SSH_KEY_FILE=~/.ssh/id_ed25519

# --- Versions (empty = default from terraform/variables.tf) --------------------
#PANGOLIN_VERSION=1.27.1
#GERBIL_VERSION=1.6.0
#TRAEFIK_VERSION=v3.7.16
#BADGER_VERSION=v1.8.0

# --- Behaviour -----------------------------------------------------------------
# true = no prompts (apply/destroy without confirmation)
AUTO_APPROVE=false
# Max. time to wait for the DNS record, in seconds
DNS_WAIT_TIMEOUT=1800
# Public resolver for DNS checks
DNS_RESOLVER=1.1.1.1
