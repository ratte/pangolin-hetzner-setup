# Kopieren nach .env und ausfüllen:  cp .env.example .env && chmod 600 .env
# .env wird nie committet (.gitignore).

# --- Pflicht -------------------------------------------------------------------
# Hetzner Console → Projekt → Sicherheit → API-Tokens (Lesen & Schreiben).
# Leer lassen: ./setup.sh fragt verdeckt danach und bietet an, ihn hier zu speichern.
HCLOUD_TOKEN=
# FQDN des Pangolin-Dashboards (A-Record muss auf den Server zeigen)
DASHBOARD_DOMAIN=pangolin.example.ch
# Basis-Domain für Ressourcen (z. B. app.example.ch)
BASE_DOMAIN=example.ch
# Kontaktadresse für Let's Encrypt
LETSENCRYPT_EMAIL=admin@example.ch

# --- Server --------------------------------------------------------------------
SERVER_NAME=pangolin
SERVER_TYPE=cx23
LOCATION=nbg1
IMAGE=ubuntu-26.04
TIMEZONE=Europe/Zurich
# Neustart nach Sicherheitsupdates (HH:MM) oder "off"
AUTO_REBOOT_TIME=04:00
# true = Hetzner Lösch-/Rebuild-Schutz
PROTECTION=false

# --- Zugang --------------------------------------------------------------------
# SSH-Key-Quelle. ./setup.sh fragt vor dem Erstellen des Servers danach und
# speichert die Antwort hier. Eines von beiden (oder beide) genügt:
#   GITHUB_USER     -> Keys von https://github.com/<GITHUB_USER>.keys
#   SSH_PUBLIC_KEY  -> eigener öffentlicher Key, in Anführungszeichen
GITHUB_USER=
SSH_PUBLIC_KEY=
# Login-Benutzer auf dem Server (root ist gesperrt). ./setup.sh fragt vor dem
# Erstellen des Servers nach und schlägt diesen Wert vor.
ADMIN_USER=peng
# SSH-Port auf dem Server (Port 22 wird geschlossen)
SSH_PORT=2222
# SSH-Quellnetze beim Erstellen: "any" = überall offen. Später einschränken mit
#   ./setup.sh admin-access "203.0.113.10/32"
ADMIN_ALLOWED_CIDRS=any
# Optional: privater Key, falls nicht im ssh-agent bzw. Standardpfad
#SSH_KEY_FILE=~/.ssh/id_ed25519

# --- Versionen (leer = Standard aus terraform/variables.tf) --------------------
#PANGOLIN_VERSION=1.27.1
#GERBIL_VERSION=1.6.0
#TRAEFIK_VERSION=v3.7.16
#BADGER_VERSION=v1.8.0

# --- Ablauf --------------------------------------------------------------------
# true = keine Rückfragen (apply/destroy ohne Bestätigung)
AUTO_APPROVE=false
# Max. Wartezeit auf den DNS-Eintrag in Sekunden
DNS_WAIT_TIMEOUT=1800
# Öffentlicher Resolver für DNS-Prüfungen
DNS_RESOLVER=1.1.1.1
